{
  "icon_theme": "Material Icon Theme",
  "theme": "Ayu Light",
  "ui_font_size": 15,
  "ui_font_weight": 400,
  "ui_font_family": "FiraCode Nerd Font Mono",
  "buffer_font_size": 13,
  "buffer_font_weight": 400,
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "edit_predictions": {
    "provider": "none",
    "disabled_globs": [
      "**/*",
      "**/*.*"
    ]
  },
  "features": {
    "collab": false,
    "assistant": false,
    "chat": false
  },
  "agent": {
    "enabled": false,
  },
  "collaboration_panel": {
    "button": false
  },
  "chat_panel": {
    "button": "never"
  },
  "format_on_save": "on",
  "lsp": {
    "rust-analyzer": {
      "enable_lsp_tasks": true,
      "path": "/run/current-system/sw/bin/rust-analyzer",
      "initialization_options": {
        "check": {
          "command": "clippy"
        }
      },
      "inlayHints": {
        "maxLength": null,
        "lifetimeElisionHints": {
          "enable": "skip_trivial",
          "useParameterNames": true
        },
        "closureReturnTypeHints": {
          "enable": "always"
        }
      }
    },
    "tinymist": {
      "settings": {
        "exportPdf": "onSave",
        "outputPath": "$root/$name"
      }
    }
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": true
  },
  "inlay_hints": {
    "enabled": false
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false
  },
  "title_bar": {
    "show_branch_status_icon": true
  },
  "middle_click_paste": false,
  "indent_guides": {
    "coloring": "indent_aware"
  },
  "tabs": {
    "file_icons": true
  },
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true
    }
  },
  "terminal": {
    "font_weight": 400.0,
    "toolbar": {
      "breadcrumbs": false
    }
  },
  "project_panel": {
    "default_width": 300
  },
  "git_panel": {
    "default_width": 300
  },
  "outline_panel": {
    "button": false,
    "default_width": 360,
    "dock": "right"
  },
  "load_direnv": "shell_hook",
  "auto_install_extensions": {
    "c#": true,
    "elixir": true,
    "html": true,
    "javascript": true,
    "make": true,
    "nix": true,
    "rust": true,
    "toml": true,
    "typst": true
  }
}
