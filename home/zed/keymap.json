    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-shift-d": "debug_panel::ToggleFocus"
    }
  },
  {
    "context": "Picker > Editor",
    "bindings": {
      "ctrl-h": "editor::Backspace"
    }
  },
  {
    "context": "Picker > Editor",
    "unbind": {
      "ctrl-h": "editor::Backspace"
