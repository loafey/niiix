[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
      "ctrl-å": "workspace::ToggleBottomDock",
      "ctrl-ö": "terminal_panel::ToggleFocus",
      "alt-x": "editor::ExpandMacroRecursively",
      "alt-r": "editor::RestartLanguageServer",
      "alt-d": "editor::OpenDocs"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-shift-up": "editor::AddSelectionAbove", // Insert Cursor Above
      "ctrl-shift-down": "editor::AddSelectionBelow", // Insert Cursor Below
      "ctrl-'": [
        "editor::ToggleComments",
        {
          "advance_downwards": false
        }
      ]
      // "j k": ["workspace::SendKeystrokes", "escape"]
    }
  },
  {
    "bindings": {
      "ctrl-b": "project_panel::Toggle"
    }
  },
  {
